# ==============================

# Django / Python .gitignore

# ==============================

# ---- Python bytecode ----

**pycache**/
*.py[cod]
*$py.class

# ---- C extensions ----

*.so

# ---- Virtual environments ----

.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ---- Environment variables ----

.env
.env.*
!.env.example

# ---- Django stuff ----

*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Media & static (optional depending on setup)

media/
staticfiles/

# If you collect static in project

# static/

# ---- Migrations (optional rule) ----

# Uncomment if you DON'T want migrations in git

# */migrations/*

# !*/migrations/**init**.py

# ---- Admin / OS files ----

.DS_Store
Thumbs.db
desktop.ini

# ---- IDEs / Editors ----

.vscode/
.idea/
*.swp
*.swo
*~

# ---- Testing / coverage ----

.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---- Type checkers / linters ----

.mypy_cache/
.ruff_cache/
.pyre/

# ---- Jupyter Notebook ----

.ipynb_checkpoints/

# ---- Distribution / packaging ----

build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---- Node (if frontend inside Django) ----

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Celery / background jobs ----

celerybeat-schedule
celerybeat.pid

# ---- Redis / cache dumps ----

dump.rdb

# ---- Logs ----

logs/
*.log

# ---- Sentry / crash reports ----

*.stackdump

# ---- Docker ----

*.pid
*.seed
*.pid.lock

# ---- Backup files ----

*.bak
*.tmp
*.orig

# ==============================

# End of file

# ==============================
